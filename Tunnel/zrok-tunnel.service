[Unit]
Description=Zrok RestAPI Tunnel
After=network-online.target esp32-bridge.service
Wants=network-online.target
Requires=esp32-bridge.service

[Service]
Type=simple
User=dietpi
Environment=HOME=/home/dietpi
ExecStart=/usr/local/bin/zrok-reset-run.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
