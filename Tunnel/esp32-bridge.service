[Unit]
Description=Flask REST API Bridge for ESP32
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/dietpi/API Cloud/REST/Tunnel
Environment="PYTHONPATH=/home/dietpi/API Cloud/REST/Tunnel"
ExecStart="/home/dietpi/API Cloud/REST/Tunnel/.venv/bin/python3" "/home/dietpi/API Cloud/REST/Tunnel/script.py"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
