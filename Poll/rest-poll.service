[Unit]
Description=Poll Service for RaspPi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/dietpi/API Cloud/REST/Poll
ExecStart="/home/dietpi/API Cloud/REST/Poll/.venv/bin/python3" "/home/dietpi/API Cloud/REST/Poll/script.py"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
